# Disable directory browsing across the entire application
Options -Indexes

# Block direct HTTP access to all dotfiles (.env, .env.example, .git, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct HTTP access to sensitive configuration, SQL, composer, and log files
<FilesMatch "\.(sql|enc|log|ini|sh|bak|lock|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct HTTP access to internal backend directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|database|services|middleware|helpers|includes|storage|scratch|tests)(/|$) - [F,L,NC]
</IfModule>
